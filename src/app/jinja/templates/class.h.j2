{% import "utils.j2" as utils %}
{# ============================================================================= Comment block for file header #}
{{ utils.generate_file_header(name_and_version, source, file, timestamp) }}


{# ======================================================================================== Open include guard #}
#ifndef {{ model.include_guard }}
#define {{ model.include_guard }}


{# ================================================================================ Comment block for Includes #}
{{ utils.generate_comment_block(title="Includes") }}
{# ============================================================================================== Add Includes #}
{% for inc in model.includes_h.system %}
#include <{{ inc }}>
{% endfor %}
{% for inc in model.includes_h.project %}
#include "{{ inc }}"
{% endfor %}


{# =========================================================================================== Open namespaces #}
{% for ns in model.namespaces %}
namespace {{ ns }} {
{% endfor %}


{# ================================================================================================ Open class #}
/// @brief {{ model.description }}
class {{ model.name }}{% if model.inherits %} :
{% for b in model.inherits %}
{{ tab }}{% if b.virtual %}virtual {% endif -%}
{{ b.visibility }} {{ b.name }}{% if not loop.last %},{% endif %}

{% endfor %}
{
{% else %}

{
{% endif %}

{# ================================================================= Comment block for Constructors/Destructor #}
{{ utils.generate_comment_block(title="Constructors/Destructor") }}
{# =============================================================================== Add Constructors/Destructor #}
public:
{% for c in model.constructors %}

{{ utils.generate_class_constructor_h(c, model.name, tab) }}
{% endfor %}

{{ utils.generate_class_destructor_h(model.name, tab) }}

{# ========================================================================== Comment block for Public Members #}
{{ utils.generate_comment_block(title="Public Members") }}
{# ======================================================================================== Add Public Members #}
public:
{% for m in model.members.public %}

{{ utils.generate_class_member_h(m, tab) }}
{% endfor %}

{# ======================================================================== Comment block for Protected Members #}
{{ utils.generate_comment_block(title="Protected Members") }}
{# ====================================================================================== Add Protected Members #}
protected:
{% for m in model.members.protected %}

{{ utils.generate_class_member_h(m, tab) }}
{% endfor %}

{# ========================================================================== Comment block for Private Members #}
{{ utils.generate_comment_block(title="Private Members") }}
{# ======================================================================================== Add Private Members #}
private:
{% for m in model.members.private %}

{{ utils.generate_class_member_h(m, tab) }}
{% endfor %}

{# =========================================================================== Comment block for Public Methods #}
{{ utils.generate_comment_block(title="Public Methods") }}
{# ========================================================================================= Add Public Methods #}
public:
{% for m in model.methods.public %}

{{ utils.generate_class_method_h(m, tab) }}
{% endfor %}

{# ======================================================================== Comment block for Protected Methods #}
{{ utils.generate_comment_block(title="Protected Methods") }}
{# ====================================================================================== Add Protected Methods #}
protected:
{% for m in model.methods.protected %}

{{ utils.generate_class_method_h(m, tab) }}
{% endfor %}

{# ========================================================================== Comment block for Private Methods #}
{{ utils.generate_comment_block(title="Private Methods") }}
{# ======================================================================================== Add Private Methods #}
private:
{% for m in model.methods.private %}

{{ utils.generate_class_method_h(m, tab) }}
{% endfor %}

{# =============================================================================================== Close class #}
}; // class {{ model.name }}


{# ========================================================================================== Close namespaces #}
{% for ns in model.namespaces | reverse %}
} // namespace {{ ns }}
{% endfor %}


{# ======================================================================================= Close include guard #}
#endif // {{ model.include_guard }}

